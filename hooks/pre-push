#!/usr/bin/env bash
#
# pre-push — two independent gates, run back to back:
#   Stage 1: validate-brain drift gate (corpus-wide, ratcheted, ERROR-based).
#   Stage 2: this repo's OWN validation gates, read from planning/harness.json.
#
# Stage 1 background: the full 5-flag `validate-brain` suite already runs nightly on the
# Mac Mini (scripts/validate_brain.sh, wired from scripts/routine.sh) and exits non-zero
# on failure — but that is detection only: nightly, remote, log-only, and it gates
# nothing. A bad commit made on any machine can be pushed immediately, and the drift is
# only discovered a day later in a log file nobody is looking at. This hook moves the
# same check to the push boundary, where it can actually stop a regression from landing.
#
# Failure mode: block on NEW errors only, against a tracked baseline
# (hooks/validate-baseline.json) — never on any error. `core/engine-rs` alone currently
# carries 9 committed E_GRAPH_DANGLING_RELATED errors; a block-on-any gate would be red
# from day one there and would just get bypassed with --no-verify forever. The baseline
# ratchets DOWN only (see scripts/validate_brain.sh) — it is safe to be stale-high, and
# must never silently absorb an increase.
#
# Scope: the baseline is corpus-wide and singular, not per-repo. `validate-brain`
# resolves the brain root by walking UP from wherever it runs and always validates the
# ENTIRE corpus regardless of cwd — so a push from core/engine-rs and a push from HQ see
# the identical error set. hooks/validate-baseline.json lives in HQ only and is read
# read-only from every sub-repo via the resolved brain root.
#
# Known constraint: validate-brain's check flags do NOT compose (main.rs:665-678 is an
# if/else-if chain — the first flag present wins). --sync --graph --state --links
# --structure therefore need five separate invocations, same as
# scripts/validate_brain.sh. Do not try to pass multiple flags in one call.
#
# Stage 2 background: stage 1 only ever measures brain-corpus drift — it says nothing
# about whether THIS repo's own code (lint/types/tests/build) still works. Solo-operator
# failure mode: "I forgot to run the gate" before pushing. Stage 2 closes that for any
# repo carrying `planning/harness.json` (the checks manifest the SDLC engines already
# read for Test/Review) by re-running its `validation.checks[]` entries where
# `gates: true`, from the repo's own root, at push time. No new config format — it reads
# the same file the SDLC pipeline already treats as the source of truth for "what does
# passing look like".
#
# Both stages degrade gracefully by construction, same spirit as hooks/post-commit:
#   - no brain.toml found walking up (standalone checkout)   -> stage 1 skips, notice only
#   - `bastion` not on PATH                                   -> stage 1 skips, warning only
#   - validate-brain output for a flag doesn't parse           -> that flag contributes 0,
#                                                                  warning only (never blocks)
#   - no planning/harness.json in this repo                    -> stage 2 skips, notice only
#   - harness.json unparseable / no gated checks                -> stage 2 skips, warning only
#   - `python3` not on PATH                                     -> stage 2 skips, warning only
#   - stack's marker file missing (e.g. nextjs w/o package.json) -> stage 2 skips, notice only
#     (repo declared its stack in harness.json but hasn't been scaffolded yet — a
#     placeholder harness.json is not a real failure)
#   - a gated check's own command isn't on PATH                  -> that check is skipped,
#                                                                    warning only
# Warnings never block a push. Only a measured, real non-zero exit from a gated check
# (stage 2) or an over-baseline error total (stage 1) blocks.
#
# ~8s for stage 1 (5 invocations x ~1.6s, measured). Stage 2's cost is whatever the
# repo's own lint/type/test/build commands cost — can be tens of seconds to a few
# minutes for a full Next.js build. This lives at pre-push, not pre-commit, on purpose:
# that cost is fine once per push, not once per commit.
#
# Escape hatch: `git push --no-verify` skips this hook (both stages) entirely. This is a
# speed bump against silent drift, not a security control — it is not meant to be
# unbypassable.
#
set -uo pipefail

# Consume stdin sent by git push (local_ref local_sha remote_ref remote_sha) to prevent SIGPIPE in caller
cat >/dev/null

# --- Resolve the brain root by walking up for brain.toml (stage 1 only). ----------------
find_brain_root() {
  local d="$1"
  while [ "$d" != "/" ] && [ -n "$d" ]; do
    if [ -f "$d/brain.toml" ]; then
      printf '%s\n' "$d"
      return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}

start_dir="$(pwd)"

# =========================================================================================
# Stage 1 — validate-brain drift gate.
# =========================================================================================
stage1_validate_brain() {
  local brain_root
  brain_root="$(find_brain_root "$start_dir")"
  if [ -z "$brain_root" ]; then
    echo "pre-push: no brain.toml found walking up from $start_dir — skipping validate-brain gate (standalone checkout)" >&2
    return 0
  fi

  if ! command -v bastion >/dev/null 2>&1; then
    echo "pre-push: warning: 'bastion' not found on PATH — skipping validate-brain gate. Install bastion to enable it." >&2
    return 0
  fi

  local FLAGS=(--sync --graph --state --links --structure)
  local total=0
  local diagnostics=""

  echo "pre-push: [stage 1/2] running validate-brain gate (${#FLAGS[@]} checks, corpus root: $brain_root)..." >&2

  local flag out start_ts end_ts elapsed summary_line n
  for flag in "${FLAGS[@]}"; do
    printf 'pre-push:   %s ... ' "$flag" >&2
    start_ts=$(date +%s 2>/dev/null || echo 0)
    out="$(bastion validate-brain "$flag" </dev/null 2>&1)"
    end_ts=$(date +%s 2>/dev/null || echo 0)
    elapsed=$((end_ts - start_ts))
    summary_line="$(printf '%s\n' "$out" | grep -E '^validated .*: [0-9]+ error\(s\), [0-9]+ warning\(s\)$' | tail -1)"
    if [ -z "$summary_line" ]; then
      echo "warning: unparseable output (${elapsed}s) — treating as 0 errors" >&2
      continue
    fi
    n="$(printf '%s\n' "$summary_line" | sed -E 's/^validated .*: ([0-9]+) error\(s\).*/\1/')"
    case "$n" in
      ''|*[!0-9]*)
        echo "warning: unparseable error count (${elapsed}s) — treating as 0 errors" >&2
        continue
        ;;
    esac
    echo "$summary_line (${elapsed}s)" >&2
    total=$((total + n))
    if [ "$n" -gt 0 ]; then
      local flag_diagnostics
      flag_diagnostics="$(printf '%s\n' "$out" | grep -E '^error \[' || true)"
      [ -n "$flag_diagnostics" ] && diagnostics="${diagnostics}${flag_diagnostics}
"
    fi
  done

  echo "pre-push: [stage 1/2] validate-brain gate finished — $total total error(s) (baseline check next)" >&2

  local baseline_file="$brain_root/hooks/validate-baseline.json"
  local baseline=0
  if [ -f "$baseline_file" ]; then
    local parsed
    parsed="$(python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    print(int(d.get("errors", 0)))
except Exception:
    print(0)
' "$baseline_file" 2>/dev/null)"
    case "$parsed" in
      ''|*[!0-9]*) baseline=0 ;;
      *) baseline="$parsed" ;;
    esac
  fi

  # --- Attribution: block on what THIS push introduced, not on the global total. -----------
  #
  # The baseline is corpus-wide and singular, so a bare `total > baseline` test blocks every
  # hooked repo whenever any file anywhere is bad — including files this repo never touched,
  # written by another session or an unattended routine. That is how a gate gets muted with
  # --no-verify forever. Attribution fixes the fairness without narrowing what is CHECKED:
  # the whole corpus is still validated, because the errors worth catching are relational
  # (delete a doc in one repo, dangle a `related:` edge in another). Only the BLOCKING
  # decision narrows, and it narrows by delta rather than by path — deleting docs/foo.md
  # surfaces the error on bar.md, a file the push never touched, and must still block.
  #
  # last-good lives under .git/ deliberately: untracked, per-clone, never committed, so it
  # cannot drift into the corpus or be shared. Absent (fresh clone) -> fall back to the
  # tracked baseline, i.e. exactly the old behaviour.
  #
  # PREPUSH_STRICT=1 forces the whole-corpus test — for a deploy, a big merge, or before
  # propagating hooks fleet-wide, when "all of it correct" is the actual question.
  local last_good=""
  local git_dir
  git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
  [ -n "$git_dir" ] && last_good="$git_dir/validate-last-good.json"

  local strict="${PREPUSH_STRICT:-0}"

  if [ "$strict" = "1" ]; then
    if [ "$total" -gt "$baseline" ]; then
      echo "" >&2
      echo "pre-push: BLOCKED (stage 1, STRICT) — the corpus carries $total error(s) against a baseline of $baseline." >&2
      echo "" >&2
      [ -n "$diagnostics" ] && printf '%s' "$diagnostics" >&2
      echo "" >&2
      echo "pre-push: strict mode blocks on the whole-corpus total, not just what this push introduced." >&2
      echo "pre-push: fix the error(s) above, re-run without PREPUSH_STRICT, or bypass with 'git push --no-verify'." >&2
      echo "" >&2
      return 1
    fi
    echo "pre-push: [stage 1/2] STRICT: whole corpus clean ($total error(s) vs baseline $baseline)." >&2
  elif [ -n "$last_good" ] && [ -f "$last_good" ] && command -v python3 >/dev/null 2>&1; then
    local introduced
    introduced="$(printf '%s' "$diagnostics" | python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        known = set(json.load(f).get("errors", []))
except Exception:
    known = None
current = [ln for ln in sys.stdin.read().splitlines() if ln.strip()]
if known is None:          # unreadable last-good: say nothing, caller falls back
    sys.exit(3)
# dict.fromkeys dedupes while preserving order: the same diagnostic is reported once per
# validate-brain flag that surfaces it, and printing it five times helps nobody.
for ln in dict.fromkeys(current):
    if ln not in known:
        print(ln)
' "$last_good" 2>/dev/null)"
    local rc=$?
    if [ "$rc" -eq 3 ]; then
      echo "pre-push: warning: could not read $last_good — falling back to the tracked baseline." >&2
      if [ "$total" -gt "$baseline" ]; then
        echo "pre-push: BLOCKED (stage 1) — $total error(s) against baseline $baseline." >&2
        [ -n "$diagnostics" ] && printf '%s' "$diagnostics" >&2
        return 1
      fi
    elif [ -n "$introduced" ]; then
      echo "" >&2
      echo "pre-push: BLOCKED (stage 1) — this push introduces new corpus error(s):" >&2
      echo "" >&2
      printf '%s\n' "$introduced" >&2
      echo "" >&2
      echo "pre-push: these are new since this clone's last successful push. The corpus carries" >&2
      echo "pre-push: $total error(s) in total; the rest pre-date your work and are not blocking you." >&2
      echo "pre-push: fix the new error(s) above, or bypass this check with 'git push --no-verify'." >&2
      echo "" >&2
      return 1
    else
      if [ "$total" -gt 0 ]; then
        echo "pre-push: [stage 1/2] no NEW errors from this push; $total pre-existing error(s) reported, not blocking." >&2
        echo "pre-push:   (run 'PREPUSH_STRICT=1 git push' to gate on the whole corpus, or scripts/validate_brain.sh to see them all)" >&2
      fi
    fi
  else
    # No last-good yet (fresh clone) or no python3: the original whole-corpus behaviour.
    if [ "$total" -gt "$baseline" ]; then
      echo "" >&2
      echo "pre-push: BLOCKED (stage 1) — validate-brain error count increased." >&2
      echo "" >&2
      [ -n "$diagnostics" ] && printf '%s' "$diagnostics" >&2
      echo "" >&2
      echo "pre-push: baseline is $baseline error(s); this push would leave the corpus at $total error(s)." >&2
      echo "pre-push: fix the new error(s) above, or bypass this check with 'git push --no-verify'." >&2
      echo "" >&2
      return 1
    fi
  fi

  # Passed. Record the current error set as this clone's new high-water mark, so the next
  # push is judged against what the corpus looked like when we last let one through.
  if [ -n "$last_good" ] && command -v python3 >/dev/null 2>&1; then
    printf '%s' "$diagnostics" | python3 -c '
import json, sys
path = sys.argv[1]
errors = sorted({ln for ln in sys.stdin.read().splitlines() if ln.strip()})
try:
    with open(path, "w") as f:
        json.dump({"errors": errors}, f, indent=2)
        f.write("\n")
except OSError:
    pass
' "$last_good" 2>/dev/null || true
  fi

  return 0
}

# =========================================================================================
# Stage 2 — this repo's own gates, read from planning/harness.json (validation.checks[]
# where gates:true). Mirrors what the SDLC engines already run for Test/Review — this is
# the same policy file, just re-run at the push boundary.
# =========================================================================================
stage2_repo_gates() {
  local harness_file="$start_dir/planning/harness.json"

  if [ ! -f "$harness_file" ]; then
    echo "pre-push: [stage 2/2] no planning/harness.json in $start_dir — skipping repo gate" >&2
    return 0
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-push: warning: 'python3' not found on PATH — skipping repo gate (can't parse harness.json)." >&2
    return 0
  fi

  local parsed
  parsed="$(python3 -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
except Exception:
    sys.exit(1)
print("STACK\t" + str(d.get("stack", "")))
checks = d.get("validation", {}).get("checks", [])
if not isinstance(checks, list):
    checks = []
for c in checks:
    if not isinstance(c, dict):
        continue
    if c.get("gates") is not True:
        continue
    name = c.get("name", "")
    cmd = c.get("command", "")
    if name and cmd:
        print(f"{name}\t{cmd}")
' "$harness_file" 2>/dev/null)"

  if [ -z "$parsed" ]; then
    echo "pre-push: warning: planning/harness.json unparseable or has no validation.checks[] — skipping repo gate." >&2
    return 0
  fi

  local stack
  stack="$(printf '%s\n' "$parsed" | head -1 | sed -E 's/^STACK\t//')"
  local checks
  checks="$(printf '%s\n' "$parsed" | tail -n +2)"

  if [ -z "$checks" ]; then
    echo "pre-push: [stage 2/2] planning/harness.json has no gates:true checks — skipping repo gate." >&2
    return 0
  fi

  # A stack declared in harness.json before the repo is actually scaffolded (e.g. a
  # placeholder committed ahead of `create-next-app`) is not a real failure — it just
  # means there's nothing to run yet. Skip on the stack's marker file being absent.
  local marker=""
  case "$stack" in
    nextjs|node|next) marker="package.json" ;;
    rust) marker="Cargo.toml" ;;
    python) marker="pyproject.toml" ;;
  esac
  if [ -n "$marker" ] && [ ! -f "$start_dir/$marker" ]; then
    echo "pre-push: [stage 2/2] stack '$stack' declared in harness.json but $marker not found in $start_dir — repo looks unscaffolded, skipping repo gate." >&2
    return 0
  fi

  echo "pre-push: [stage 2/2] running repo gate ($(printf '%s\n' "$checks" | wc -l | tr -d ' ') gated check(s), repo root: $start_dir)..." >&2

  local any_fail=0
  local failed_names=""
  local name cmd first_word out rc start_ts end_ts elapsed
  while IFS=$'\t' read -r name cmd; do
    [ -z "$name" ] && continue
    first_word="${cmd%% *}"
    if ! command -v "$first_word" >/dev/null 2>&1; then
      echo "pre-push:   warning: '$first_word' not on PATH — skipping check '$name' ($cmd)." >&2
      continue
    fi
    printf 'pre-push:   %s (%s) ... ' "$name" "$cmd" >&2
    start_ts=$(date +%s 2>/dev/null || echo 0)
    out="$(cd "$start_dir" && sh -c "$cmd" </dev/null 2>&1)"
    rc=$?
    end_ts=$(date +%s 2>/dev/null || echo 0)
    elapsed=$((end_ts - start_ts))
    if [ "$rc" -ne 0 ]; then
      echo "FAILED (${elapsed}s, exit $rc)" >&2
      failed_names="${failed_names}${name} "
      any_fail=1
      echo "--- last 30 lines of '$name' output ---" >&2
      printf '%s\n' "$out" | tail -n 30 >&2
      echo "---" >&2
    else
      echo "passed (${elapsed}s)" >&2
    fi
  done <<< "$checks"

  if [ "$any_fail" -ne 0 ]; then
    echo "" >&2
    echo "pre-push: BLOCKED (stage 2) — repo gate check(s) failed: $failed_names" >&2
    echo "pre-push: fix the failure(s) above, or bypass this check with 'git push --no-verify'." >&2
    echo "" >&2
    return 1
  fi

  return 0
}

# =========================================================================================
# Advisory — is the INSTALLED `mev` binary stale vs its source tree? Never blocks.
#
# Why this is worth noise: `mev` is the fleet's WRITER. `mev emit-state --write` rewrites
# derived files across every repo in brain.toml, and both `/log-work` and
# scripts/routine.sh invoke it from PATH. A stale install therefore keeps writing with
# whatever derivation logic it was built with, silently.
#
# This is not hypothetical. On 2026-08-04 the append-only revision-history writer
# (MV.ticket.append-only-emit-state-writer) shipped, merged, and closed — while
# ~/.cargo/bin/mev still held a pre-merge build. Every real `emit-state --write` for hours
# afterward ran WITHOUT the safety net the ticket had just added, and nothing surfaced it.
#
# Why it goes stale on THIS machine specifically: scripts/build_and_install.sh reinstalls a
# binary only when git_sync.sh PULLED new commits for its repo. Commits AUTHORED locally
# never trip that condition — so the machine doing the work is exactly the one that drifts,
# while the Mac Mini self-heals on its next cron pull.
#
# Detection is free: mev's own `toolchain-freshness` conformance check already compares its
# compiled-in build stamp (MEV_BUILD_GIT_SHA) against its source tree's live HEAD. Nothing
# was acting on the result. This just says it out loud, once per push (~50ms).
#
# Advisory ONLY — a stale binary is not a reason to refuse a push. It is a reason to tell
# you before cron next runs it. Same contract as every other soft path in this hook.
# =========================================================================================
advisory_mev_freshness() {
  command -v mev >/dev/null 2>&1 || return 0   # not installed here — nothing to be stale

  local out
  out="$(mev conformance 2>/dev/null)" || return 0   # a probe failure must never matter

  case "$out" in
    *"toolchain-freshness [DRIFT]"*) ;;
    *) return 0 ;;
  esac

  echo "" >&2
  echo "pre-push: NOTICE — the installed 'mev' binary is STALE vs its source tree." >&2
  printf '%s\n' "$out" \
    | grep -A3 'toolchain-freshness \[DRIFT\]' \
    | sed 's/^/pre-push:   /' >&2
  echo "pre-push:" >&2
  echo "pre-push:   mev is the fleet writer — a stale copy runs 'emit-state --write' with" >&2
  echo "pre-push:   old derivation logic against every repo in brain.toml. Refresh with:" >&2
  echo "pre-push:     cargo install --path core/mev --force" >&2
  echo "" >&2
  return 0
}

# =========================================================================================
# Run both stages; block if either fails. The freshness advisory runs after them so it is
# the last thing on screen rather than buried under stage output — and it runs on the
# blocked path too, since a stale writer is worth knowing about either way.
# =========================================================================================
rc1=0
stage1_validate_brain || rc1=$?
rc2=0
stage2_repo_gates || rc2=$?

advisory_mev_freshness

if [ "$rc1" -ne 0 ] || [ "$rc2" -ne 0 ]; then
  exit 1
fi

exit 0
