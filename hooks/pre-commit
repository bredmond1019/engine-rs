#!/usr/bin/env bash
#
# pre-commit — two independent author-time gates, run back to back:
#   Gate 1: OKF frontmatter YAML parse gate (staged .md files only).
#   Gate 2: corpus graph/structure delta gate (whole corpus, every commit).
#
# --- Gate 1: OKF frontmatter YAML parse gate -------------------------------------------
#
# Why this exists: a `: ` (colon-space), unquoted `#`, or an em-dash clause inside an
# unquoted plain scalar in OKF frontmatter (typically `description:`/`title:`) breaks
# YAML parsing with `mapping values are not allowed in this context` — and because
# `mev validate-brain`'s --structure/--links/--graph/--state flags all load the same
# frontmatter, one bad description fails all four simultaneously and looks like four
# broken gates for a change unrelated to any of them. This recurred three separate
# times on 2026-08-06 alone, across three independent agent sessions (see
# planning/state.json carryover `okf-frontmatter-unquoted-colon-trap`) after already
# being fixed once and re-filed as a systemic gate a day earlier
# (core/_planning/orchestrator/state.json carryover
# `frontmatter-colon-parse-failures-recur-fleet-wide`). This gate catches it at commit
# time, before it ever reaches validate-brain.
#
# Scope: staged .md files only, checked against their STAGED content (`git show :<path>`),
# not the working tree — so this reflects exactly what is about to be committed, and is
# immune to unrelated unstaged edits sitting in the same file.
#
# Degrades gracefully, same spirit as hooks/post-commit and hooks/pre-push:
#   - no staged .md files                    -> gate 1 skipped, silent
#   - python3 not on PATH                    -> gate 1 skipped, warning only
#   - PyYAML not importable                  -> gate 1 skipped, warning only
#   - hooks/check_frontmatter.py missing     -> gate 1 skipped, warning only
# The checker itself never blocks a commit by failing to run — only a real YAML parse
# error in a staged file's frontmatter does.
#
# --- Gate 2: corpus graph/structure delta gate ------------------------------------------
#
# Why this exists: a wrong doc_id or a missing cross-repo prefix in a `related:` list, or
# an index.md row pointing at a file that no longer exists, was previously caught only at
# PUSH time (hooks/pre-push stage 1, or preflight.sh) — often a whole session later than
# the edit that caused it, discovered only when a push is blocked. This gate runs the same
# two cheap `bastion validate-brain` flags (--graph ~1s, --structure ~1s; --links/--state
# are deliberately left at push time — --links alone costs ~11s, too slow to pay on every
# commit) at commit time instead, via the shared hooks/validate_brain_gate.sh (see its
# header for the full new-errors-only attribution rule this reuses from pre-push's stage 1
# — it blocks only the commit that actually introduces a new corpus error, never a commit
# for a pre-existing problem someone else left unresolved).
#
# Unconditional — unlike gate 1, this does NOT skip when no .md file is staged. A commit
# that only touches planning/state.json (the common case for `emit_state_write.sh`, since
# every sub-repo's planning/ is a symlink into this HQ git — CLAUDE.md standing rule 10)
# still deserves the check: validate-brain always scores the WHOLE corpus regardless of
# what this commit touched, because the errors worth catching are relational (a change in
# one file can dangle a `related:` edge or index.md row in another, untouched file).
#
# Degrades gracefully, same spirit as gate 1 and hooks/pre-push:
#   - no brain.toml found walking up          -> gate 2 skipped, notice only
#   - `bastion` not on PATH                   -> gate 2 skipped, warning only
#   - hooks/validate_brain_gate.sh missing    -> gate 2 skipped, warning only
#
# --- Gate 3: destructive-overwrite guard (status-marker survival) ----------------------
#
# Why this exists: `HQ.chore.a-write-to-an-existing-corpus-path-is-unguarded`. Four times
# in one run an agent replaced an existing tracked corpus file believing it was authoring a
# new one — twice destroying open work (a still-open BLOCKER, and a block record filed
# minutes earlier) that no existing gate could see, because both overwrites landed through
# an ordinary, successful `git commit`. Full design record, including why this lives at
# COMMIT time rather than write time and the measurement that produced the signal below:
# planning/HQ.chore.a-write-to-an-existing-corpus-path-is-unguarded/analysis.md (Q1/Q2).
#
# Signal (measured, not assumed — analysis.md Q2): raw deletion size/ratio does NOT
# separate a destructive overwrite from a legitimate one — a real legitimate handoff.md
# rewrite deletes proportionally MORE than the verified destructive commit. What does
# separate every case tested: a same-path modification (no rename detected) that removes
# every instance of a small open-work marker vocabulary (BLOCKER / STILL OPEN / UNRESOLVED)
# the prior content had, with no same-change compensating write to planning/knowledge.md,
# planning/memory.md, or an archive/-prefixed path (the D35-distillation / `/archive`
# pattern, which records where deleted content went instead of just discarding it).
# Implemented once in hooks/destructive_overwrite_gate.sh so it can also be run standalone
# against historical commit pairs (see analysis.md's observed-run section).
#
# Degrades gracefully, same spirit as gates 1 and 2:
#   - no HEAD commit yet (first commit in the repo)      -> gate 3 skipped, silent
#   - no staged modified .md files                       -> gate 3 skipped, silent
#   - hooks/destructive_overwrite_gate.sh missing         -> gate 3 skipped, warning only
# DESTRUCTIVE_OVERWRITE_GATE=0 is the escape hatch, same shape as gate 2's
# BRAIN_GRAPH_GATE=0, in case the marker vocabulary or compensating-write heuristic needs
# to be widened before it has been proven at scale.
#
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
fail=0

# --- Gate 1: OKF frontmatter YAML parse gate --------------------------------------------
staged="$(git diff --cached --name-only --diff-filter=ACM -- '*.md')"
if [ -n "$staged" ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: warning: 'python3' not found on PATH — skipping frontmatter YAML gate." >&2
  elif ! python3 -c "import yaml" >/dev/null 2>&1; then
    echo "pre-commit: warning: PyYAML not importable — skipping frontmatter YAML gate." >&2
  else
    checker="$repo_root/hooks/check_frontmatter.py"
    if [ ! -f "$checker" ]; then
      echo "pre-commit: warning: $checker not found — skipping frontmatter YAML gate." >&2
    else
      while IFS= read -r f; do
        [ -z "$f" ] && continue
        # Staged blob content, not the working tree — reflects exactly what will be committed.
        if ! git show ":$f" 2>/dev/null | python3 "$checker" "$f"; then
          fail=1
        fi
      done <<< "$staged"
      if [ "$fail" -ne 0 ]; then
        echo "" >&2
        echo "pre-commit: BLOCKED (gate 1) — malformed YAML frontmatter (see above)." >&2
        echo "" >&2
      fi
    fi
  fi
fi

# --- Gate 2: corpus graph/structure delta gate ------------------------------------------
# RE-ENABLED BY DEFAULT 2026-09-02. Was switched off 2026-09-01 (same day it shipped) after
# a real block: a commit scoped to core/_planning/mev/ was blocked by an untracked
# sequence.md another session had written 40 minutes earlier in core/_planning/bella/ — two
# DIFFERENT sub-repos' planning vaults, but the same physical HQ git repo, so the
# repo-toplevel-only attribution that shipped 2026-09-01 could not tell them apart.
#
# The actual fix: hooks/validate_brain_gate.sh's classify_new_errors now scopes blocking by
# LANE, not merely by physical repo — a `core/<slug>/planning/...` or
# `core/_planning/<slug>/...` path (both shapes, unified) is its own lane, distinct from the
# repo's other content. A commit in core/_planning/mev/ no longer blocks on a break in
# core/_planning/bella/; it still blocks on a break inside its own vault. Verified live
# against this exact scenario 2026-09-02 (both directions) before re-enabling — see
# hooks/validate_brain_gate.sh's header for the full attribution rule and
# hooks/test_pre-commit.sh's "planning-lane" cases for the regression tests.
#
# BRAIN_GRAPH_GATE=0 is kept as an escape hatch (inverted from the 2026-09-01 default) in
# case a lane-scoping edge case surfaces before it has been re-proven at scale.
gate_script="$repo_root/hooks/validate_brain_gate.sh"
if [ "${BRAIN_GRAPH_GATE:-1}" = "0" ]; then
  : # gate 2 explicitly disabled via BRAIN_GRAPH_GATE=0
elif [ -f "$gate_script" ]; then
  # shellcheck source=hooks/validate_brain_gate.sh
  source "$gate_script"
  if ! run_validate_brain_gate "pre-commit" --graph --structure; then
    fail=1
  fi
else
  echo "pre-commit: warning: $gate_script not found — skipping corpus graph/structure gate." >&2
fi

# --- Gate 3: destructive-overwrite guard (status-marker survival) ----------------------
gate3_script="$repo_root/hooks/destructive_overwrite_gate.sh"
if [ "${DESTRUCTIVE_OVERWRITE_GATE:-1}" = "0" ]; then
  : # gate 3 explicitly disabled via DESTRUCTIVE_OVERWRITE_GATE=0
elif ! git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  : # no HEAD yet (first commit in this repo) -- nothing to compare against
elif [ -f "$gate3_script" ]; then
  # shellcheck source=hooks/destructive_overwrite_gate.sh
  source "$gate3_script"
  if ! check_destructive_overwrite "HEAD" ""; then
    echo "" >&2
    echo "pre-commit: BLOCKED (gate 3) — destructive overwrite (see above)." >&2
    echo "" >&2
    fail=1
  fi
else
  echo "pre-commit: warning: $gate3_script not found — skipping destructive-overwrite gate." >&2
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: bypass with 'git commit --no-verify' if you must." >&2
  echo "" >&2
  exit 1
fi

exit 0
